def simulate_model(
    model_wrapper,
    user_count,
    feature_data,
    sequences=None,
    seed=42
):

    rng = np.random.default_rng(seed)

    selected_indices = rng.choice(
        len(feature_data),
        size=user_count,
        replace=True
    )

    environment = ORANEnvironment(
        feature_data,
        seed=seed
    )

    total_scheduling = 0.0
    total_qos = 0
    total_resource = 0.0

    start_time = time.perf_counter()

    for index in selected_indices:

        x = feature_data[index]

        environment.features = x.copy()

        environment.bw = rng.uniform(
            MIN_BW,
            MAX_BW * 0.80
        )

        environment.rb = rng.uniform(
            MIN_RB,
            MAX_RB * 0.80
        )

        sequence = None

        if (
            model_wrapper.model_type
            == "slam_ppo"
        ):

            if sequences is not None:

                sequence = sequences[
                    index %
                    len(sequences)
                ]

        action = model_wrapper.action(
            x,
            environment,
            sequence
        )

        _, _, info = environment.step(
            action
        )

        total_scheduling += (
            info["scheduling_efficiency"]
        )

        total_qos += (
            info["qos_violation"]
        )

        total_resource += (
            info["resource_efficiency"]
        )

    elapsed = (
        time.perf_counter() -
        start_time
    )

    return {

        "users": user_count,

        "execution_time_ms":
            elapsed * 1000,

        "processing_time_ms_per_user":
            elapsed * 1000 / user_count,

        "scheduling_efficiency":
            100.0 *
            total_scheduling /
            user_count,

        "qos_violation_rate":
            100.0 *
            total_qos /
            user_count,

        "resource_allocation_efficiency":
            100.0 *
            total_resource /
            user_count
    }


