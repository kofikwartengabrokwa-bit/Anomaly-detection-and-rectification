class ModelWrapper:

    def __init__(
        self,
        name,
        model,
        model_type
    ):

        self.name = name
        self.model = model
        self.model_type = model_type

    def action(
        self,
        x,
        environment,
        sequence=None
    ):

        if self.model_type == "ppo":

            state = environment._state()

            action, _, _ = (
                self.model.select_action(
                    state
                )
            )

            return action

        elif self.model_type == "slam_ppo":

            state = self.model.construct_state(
                sequence,
                environment.bw,
                environment.rb
            )

            action, _, _ = (
                self.model.ppo.select_action(
                    state
                )
            )

            return action

        elif self.model_type == "kmeans":

            return self.model.predict_action(
                x
            )

        elif self.model_type == "kg":

            return self.model.predict_action(
                x
            )


