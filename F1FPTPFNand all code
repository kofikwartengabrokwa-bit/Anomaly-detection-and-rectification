# ============================================================
# Marker + linestyle plotting function
# ============================================================

def plot_model_with_marker(
    ax,
    x,
    y,
    model,
    linewidth=2.5,
    markersize=9,
    markevery=20,
    label=None
):
    """
    Plot one model using:
        - unique line color
        - unique linestyle
        - unique outer marker
        - small inner circular marker
    """

    style = MODEL_STYLE[model]

    # --------------------------------------------------------
    # Main line + outer marker
    # --------------------------------------------------------

    ax.plot(
        x,
        y,
        linewidth=linewidth,
        linestyle=style["linestyle"],
        color=style["color"],
        marker=style["marker"],
        markersize=markersize,
        markerfacecolor="white",
        markeredgecolor=style["color"],
        markeredgewidth=2.0,
        markevery=markevery,
        label=label,
        zorder=3
    )

    # --------------------------------------------------------
    # Inner circular marker
    # --------------------------------------------------------

    ax.plot(
        x,
        y,
        linestyle="None",
        marker="o",
        markersize=markersize * 0.38,
        markerfacecolor=style["inner_color"],
        markeredgecolor="white",
        markeredgewidth=0.7,
        markevery=markevery,
        label="_nolegend_",
        zorder=4
    )


# ============================================================
# Find Excel files
# ============================================================

excel_files = glob.glob(
    os.path.join(
        DATA_DIR,
        "model_training_metrics_with_TP_FP21ab1xa64 (3).xlsx"
    )
)

