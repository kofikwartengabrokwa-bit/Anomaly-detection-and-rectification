class ORANEnvironment:

    def __init__(self, feature_data, seed=42):

        self.X = feature_data
        self.rng = np.random.default_rng(seed)

        self.max_bw = MAX_BW
        self.max_rb = MAX_RB

        self.min_bw = MIN_BW
        self.min_rb = MIN_RB

    def reset(self):

        index = self.rng.integers(
            0,
            len(self.X)
        )

        self.features = self.X[index].copy()

        self.bw = self.rng.uniform(
            self.min_bw,
            self.max_bw * 0.80
        )

        self.rb = self.rng.uniform(
            self.min_rb,
            self.max_rb * 0.80
        )

        return self._state()

    def _state(self):

        return np.concatenate([
            self.features,
            [
                self.bw / self.max_bw,
                self.rb / self.max_rb
            ]
        ]).astype(np.float32)

    def step(self, action):

        old_bw = self.bw
        old_rb = self.rb

        if action == 0:
            # Maintain
            pass

        elif action == 1:
            # Moderate increase
            self.bw *= 1.10
            self.rb *= 1.10

        elif action == 2:
            # Aggressive increase
            self.bw *= 1.25
            self.rb *= 1.25

        elif action == 3:
            # Decrease
            self.bw *= 0.90
            self.rb *= 0.90

        self.bw = np.clip(
            self.bw,
            self.min_bw,
            self.max_bw
        )

        self.rb = np.clip(
            self.rb,
            self.min_rb,
            self.max_rb
        )

        # ----------------------------------------------------
        # Radio conditions
        # ----------------------------------------------------

        dl_bler = float(self.features[2])
        ul_bler = float(self.features[5])
        sinr = float(self.features[10])
        cqi = float(self.features[13])

        # ----------------------------------------------------
        # QoS condition
        # ----------------------------------------------------

        qos_violation = (
            dl_bler > BLER_THRESHOLD
            or
            ul_bler > BLER_THRESHOLD
            or
            sinr < SINR_THRESHOLD
            or
            cqi < CQI_THRESHOLD
        )

        # ----------------------------------------------------
        # Resource efficiency
        # ----------------------------------------------------

        bw_utilization = self.bw / self.max_bw
        rb_utilization = self.rb / self.max_rb

        resource_efficiency = (
            1.0 - abs(
                0.70 -
                (0.5 * bw_utilization +
                 0.5 * rb_utilization)
            )
        )

        resource_efficiency = np.clip(
            resource_efficiency,
            0.0,
            1.0
        )

        # ----------------------------------------------------
        # Scheduling efficiency
        # ----------------------------------------------------

        resource_gain = (
            (self.bw - old_bw) / self.max_bw
            +
            (self.rb - old_rb) / self.max_rb
        )

        scheduling_efficiency = (
            1.0
            - 0.5 * float(qos_violation)
            + 0.25 * resource_efficiency
            - 0.10 * abs(resource_gain)
        )

        scheduling_efficiency = np.clip(
            scheduling_efficiency,
            0.0,
            1.0
        )

        # ----------------------------------------------------
        # Reward
        # ----------------------------------------------------

        reward = (
            scheduling_efficiency
            +
            resource_efficiency
            -
            1.5 * float(qos_violation)
        )

        next_state = self._state()

        return (
            next_state,
            float(reward),
            {
                "qos_violation": int(qos_violation),
                "resource_efficiency": float(
                    resource_efficiency
                ),
                "scheduling_efficiency": float(
                    scheduling_efficiency
                ),
                "bw": float(self.bw),
                "rb": float(self.rb)
            }
        )
