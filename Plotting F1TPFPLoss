)


# ============================================================
# ALIGN DATA
# ============================================================

sacfl_common = (
    dfs["SACFL"]
    .set_index("Round")
    .loc[common_rounds]
)

sacdafl_common = (
    dfs["SACDAFL"]
    .set_index("Round")
    .loc[common_rounds]
)


# ============================================================
# CALCULATE STANDARD DEVIATION
# ============================================================

statistics = []

for metric in METRICS:

    sacfl_values = (
        sacfl_common[metric]
        .to_numpy(dtype=float)
    )

    sacdafl_values = (
        sacdafl_common[metric]
        .to_numpy(dtype=float)
    )

    model_values = np.vstack(
        (
            sacfl_values,
            sacdafl_values
        )
    )

    mean_values = np.mean(
        model_values,
        axis=0
    )

    # Sample SD between SACFL and SACDAFL
    std_values = np.std(
        model_values,
        axis=0,
        ddof=1
    )

    mean_sd = np.mean(
        std_values
    )

    maximum_sd = np.max(
        std_values
    )

    final_sd = std_values[-1]

    statistics.append(
        {
            "Metric": metric,
            "Mean_SD": mean_sd,
            "Maximum_SD": maximum_sd,
            "Final_SD": final_sd
        }
    )


# ============================================================
# PRINT SD RESULTS
# ============================================================

stats_df = pd.DataFrame(
    statistics
)

print("\n" + "=" * 70)
print("STANDARD DEVIATION BETWEEN SACFL AND SACDAFL")
print("=" * 70)

