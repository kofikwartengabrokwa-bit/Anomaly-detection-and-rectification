    raise FileNotFoundError(
        f"No Excel files were found in:\n{DATA_DIR}"
    )


print("=" * 80)
print("Excel files found:")
print("=" * 80)

for file in excel_files:
    print(os.path.basename(file))

print("=" * 80)


# ============================================================
# Read and combine Excel files
# ============================================================

dataframes = []

for file in excel_files:

    try:

        df = pd.read_excel(file)

        required_columns = [
            "Loss",
            "Accuracy",
            "F1",
            "TP",
            "FN",
            "epoch",
            "model"
        ]

        missing = [
            col
            for col in required_columns
            if col not in df.columns
        ]

        if missing:

            print(
                f"Skipping {os.path.basename(file)} "
                f"(missing columns: {missing})"
            )

            continue

        dataframes.append(df)

        print(
            f"Loaded: {os.path.basename(file)} "
            f"-> {len(df)} rows"
        )

    except Exception as e:

        print(
            f"Could not read {os.path.basename(file)}: {e}"
        )


if not dataframes:

    raise ValueError(
        "No valid Excel files containing the required "
        "columns were found."
    )


data = pd.concat(
    dataframes,
    ignore_index=True
)


# ============================================================
# Clean model names
# ============================================================

