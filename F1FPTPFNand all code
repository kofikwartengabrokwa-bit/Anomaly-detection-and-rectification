def train_ppo(
    feature_data,
    episodes=1,
    steps_per_episode=20
):

    environment = ORANEnvironment(
        feature_data,
        seed=SEED
    )

    initial_state = environment.reset()

    state_dim = len(initial_state)
    action_dim = 4

    agent = PPOAgent(
        state_dim,
        action_dim
    )

    rewards_history = []

    for episode in range(episodes):

        state = environment.reset()

        states = []
        actions = []
        log_probs = []
        rewards = []
        values = []

        episode_reward = 0.0

        for _ in range(steps_per_episode):

            action, log_prob, value = (
                agent.select_action(state)
            )

            next_state, reward, info = (
                environment.step(action)
            )

            states.append(state)
            actions.append(action)
            log_probs.append(log_prob)
            rewards.append(reward)
            values.append(value)

            state = next_state

            episode_reward += reward

        agent.update(
            states,
            actions,
            log_probs,
            rewards,
            values
        )

        rewards_history.append(
            episode_reward
        )

        if (episode + 1) % 50 == 0:

            print(
                f"PPO Episode "
                f"{episode + 1:03d} | "
                f"Reward = "
                f"{np.mean(rewards_history[-50:]):.4f}"
            )

    torch.save(
        agent.network.state_dict(),
        os.path.join(
            MODEL_DIR,
            "ppo.pt"
        )
    )

    return agent


