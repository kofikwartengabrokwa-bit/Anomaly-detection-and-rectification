def clean_model_names(df):
    """
    Clean model names and remove unwanted characters.
    """

    df = df.copy()

    df["model"] = (
        df["model"]
        .astype(str)
        .str.strip()
        .str.replace("\\", "", regex=False)
    )

    return df


def convert_numeric(df, columns):
    """
    Convert selected columns to numeric.
    """

    df = df.copy()

    for column in columns:

        if column in df.columns:

            df[column] = pd.to_numeric(
                df[column],
                errors="coerce"
            )

    return df


def find_training_columns(df):
    """
    Identify Loss, Accuracy and F1 columns while allowing
    small differences in capitalization.
    """

    column_map = {
        str(column).strip().lower(): column
        for column in df.columns
    }

    result = {}

    for target in TRAINING_METRICS:

        key = target.lower()

        if key in column_map:

            result[target] = column_map[key]

    return result


def prepare_dataset(df, source_name):
    """
    Clean and prepare one dataset.
    """

    df = clean_model_names(df)

    numeric_columns = [
        "epoch",
        "TP",
        "FP",
        "FN",
        "Loss",
        "Accuracy",
        "F1"
    ]

    df = convert_numeric(
        df,
        numeric_columns
    )

    df = df[
        df["model"].isin(MODELS)
    ].copy()

    df = df.dropna(
        subset=[
            "epoch",
            "model"
        ]
    )

    df = df.sort_values(
