def find_training_columns(df):

    column_map = {
        str(column).strip().lower(): column
        for column in df.columns
    }

    result = {}

    for metric in TRAINING_METRICS:

        key = metric.lower()

        if key in column_map:

            result[metric] = column_map[key]

    return result


