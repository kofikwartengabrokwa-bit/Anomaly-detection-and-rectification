        sequences.append(
            X[
                i:i + sequence_length
            ]
        )

        labels.append(
            y[
                i + sequence_length - 1
            ]
        )

    return (
        np.asarray(
            sequences,
            dtype=np.float32
        ),
        np.asarray(
            labels,
            dtype=np.int64
        )
    )


