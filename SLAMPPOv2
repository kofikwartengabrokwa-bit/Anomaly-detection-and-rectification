from sklearn.cluster import KMeans


class KMeansDecision:

    def __init__(self, n_clusters=6):

        self.kmeans = KMeans(
            n_clusters=n_clusters,
            random_state=SEED,
            n_init=10
        )

        self.cluster_actions = {}

    def fit(self, X, y):

        clusters = self.kmeans.fit_predict(X)

        for cluster in np.unique(clusters):

            indices = (
                clusters == cluster
            )

            cluster_labels = y[indices]

            # Determine dominant attack category
            dominant = np.bincount(
                cluster_labels
            ).argmax()

            # Non-benign cluster -> increase resources
            if dominant != 0:

                self.cluster_actions[
                    cluster
                ] = 1

            else:

                self.cluster_actions[
                    cluster
                ] = 0

        return self

    def predict_action(self, x):

        cluster = self.kmeans.predict(
            x.reshape(1, -1)
        )[0]

        return self.cluster_actions.get(
            cluster,
            0
        )


