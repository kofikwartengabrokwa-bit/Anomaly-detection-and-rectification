        "No valid Excel files containing the required "
        "columns were found."
    )


data = pd.concat(
    dataframes,
    ignore_index=True
)


# ============================================================
# Clean model names
# ============================================================

data["model"] = (
    data["model"]
    .astype(str)
    .str.strip()
    .str.replace("\\", "", regex=False)
)


# ============================================================
# Keep only requested models
# ============================================================

data = data[
    data["model"].isin(MODELS)
].copy()


# ============================================================
# Convert numerical columns
# ============================================================

for column in METRICS + ["epoch"]:

    data[column] = pd.to_numeric(
        data[column],
        errors="coerce"
    )


# ============================================================
# Remove invalid rows
# ============================================================

data = data.dropna(
    subset=METRICS + [
        "epoch",
        "model"
    ]
)


# ============================================================
# Sort
# ============================================================

data = data.sort_values(
    [
        "model",
        "epoch"
    ]
)


# ============================================================
# Print summary
# ============================================================

print("\n" + "=" * 80)
print("DATA SUMMARY")
print("=" * 80)

print(
    f"Total rows: {len(data)}"
)

print(
    f"Models found: "
    f"{data['model'].unique().tolist()}"
)


for model in MODELS:

    model_data = data[
        data["model"] == model
    ]

    if len(model_data) == 0:

        print(
            f"\n{model}: NO DATA"
        )

    else:

        print(
            f"\n{model}: "
            f"{len(model_data)} rows | "
            f"Epochs "
            f"{int(model_data['epoch'].min())}"
            f"-"
            f"{int(model_data['epoch'].max())}"
        )


# ============================================================
# Plot each metric
# ============================================================

for metric in METRICS:

    fig, ax = plt.subplots(
        figsize=(10, 7)
    )

    # --------------------------------------------------------
    # Plot all models
    # --------------------------------------------------------

    for model in MODELS:

        model_data = data[
            data["model"] == model
        ].sort_values("epoch")

        if model_data.empty:
            continue

        plot_model_with_marker(
            ax=ax,
            x=model_data["epoch"],
            y=model_data[metric],
            model=model,
            linewidth=2.5,
            markersize=9,
            markevery=max(
                1,
                len(model_data) // 20
            ),
            label=LEGEND_NAMES[model]
        )

    # --------------------------------------------------------
    # Axis labels
    # --------------------------------------------------------

    ax.set_xlabel(
        "Epoch",
        fontsize=20,
        fontname="Times New Roman"
    )

    ax.set_ylabel(
        metric,
        fontsize=20,
        fontname="Times New Roman"
    )

    # --------------------------------------------------------
    # Ticks
    # --------------------------------------------------------

    ax.tick_params(
        axis="both",
        labelsize=20
    )

    for label in ax.get_xticklabels():

        label.set_fontname(
            "Times New Roman"
        )

    for label in ax.get_yticklabels():

        label.set_fontname(
            "Times New Roman"
        )

    # --------------------------------------------------------
    # Legend
    # --------------------------------------------------------

    ax.legend(
        fontsize=21,
        loc="upper center",
        bbox_to_anchor=(0.5, 1.15091015),
        ncol=5,
        frameon=True,
        prop={
            "family": "Times New Roman",
            "size": 20
        }
    )

    # --------------------------------------------------------
    # Grid
    # --------------------------------------------------------

    ax.grid(
        True,
        linestyle="--",
        linewidth=0.7,
        alpha=0.5
    )

    # --------------------------------------------------------
    # Layout
    # --------------------------------------------------------

    plt.tight_layout()

    # --------------------------------------------------------
    # Save PNG
    # --------------------------------------------------------

    png_path = os.path.join(
        OUTPUT_DIR,
        f"{metric}_comparison.png"
    )

    plt.savefig(
        png_path,
        dpi=600,
        bbox_inches="tight",
        format="png"
    )

    # --------------------------------------------------------
    # Save EPS
    # --------------------------------------------------------

    eps_path = os.path.join(
        OUTPUT_DIR,
        f"{metric}_comparison.eps"
    )

    plt.savefig(
        eps_path,
        dpi=600,
        bbox_inches="tight",
        format="eps"
    )

    # --------------------------------------------------------
    # Display
    # --------------------------------------------------------

    plt.show()

    plt.close(fig)

    print(
        f"Saved: {metric}_comparison.png / "
        f"{metric}_comparison.eps"
    )


# ============================================================
# Combined figure containing all metrics
# ============================================================

fig, axes = plt.subplots(
    3,
    2,
    figsize=(16, 18)
)

axes = axes.flatten()


# ============================================================
# Plot each metric in combined figure
# ============================================================

for i, metric in enumerate(METRICS):

    ax = axes[i]

    for model in MODELS:

        model_data = data[
            data["model"] == model
        ].sort_values("epoch")

        if model_data.empty:
            continue

        plot_model_with_marker(
            ax=ax,
            x=model_data["epoch"],
            y=model_data[metric],
            model=model,
            linewidth=2.2,
            markersize=8,
            markevery=max(
                1,
                len(model_data) // 20
            ),
            label=LEGEND_NAMES[model]
        )

    # --------------------------------------------------------
    # Axis labels
    # --------------------------------------------------------

    ax.set_xlabel(
        "Epoch",
        fontsize=20,
        fontname="Times New Roman"
    )

    ax.set_ylabel(
        metric,
        fontsize=20,
        fontname="Times New Roman"
    )

    # --------------------------------------------------------
    # Ticks
    # --------------------------------------------------------

    ax.tick_params(
        axis="both",
        labelsize=20
    )

    for label in ax.get_xticklabels():

        label.set_fontname(
            "Times New Roman"
        )

    for label in ax.get_yticklabels():

        label.set_fontname(
            "Times New Roman"
        )

    # --------------------------------------------------------
    # Grid
    # --------------------------------------------------------

    ax.grid(
        True,
        linestyle="--",
        linewidth=0.6,
        alpha=0.5
    )


# ============================================================
# Remove unused sixth subplot
# ============================================================

if len(METRICS) < len(axes):

    for j in range(
        len(METRICS),
        len(axes)
    ):

        fig.delaxes(
            axes[j]
        )


# ============================================================
# Common legend at top
# ============================================================

handles, labels = (
    axes[0].get_legend_handles_labels()
)


fig.legend(
