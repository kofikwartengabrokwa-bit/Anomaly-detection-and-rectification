def create_sequences(X_data, y_data, seq_len=5):
    """
    Create temporal sequences for SLAM-LSTM.

    Returns
    -------
    X_sequences : [samples, seq_len, features]
    y_sequences : [samples]
    """

    sequences = []
    labels = []

    for i in range(
        len(X_data) - seq_len + 1
    ):

        sequences.append(
            X_data[
                i:i + seq_len
            ]
        )

        labels.append(
            y_data[
                i + seq_len - 1
            ]
        )

    return (
        np.asarray(sequences, dtype=np.float32),
        np.asarray(labels, dtype=np.int64)
    )


