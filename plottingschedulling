# ============================================================
# Function to assign requested short names
# ============================================================
def get_short_name(model_name):

    name = model_name.strip().lower()

    # --------------------------------------------------------
    # Ours
    # --------------------------------------------------------
    if (
        "ours" in name
        or "slam-lstm" in name
        or "slamlstm" in name
    ):
        return "Ours"

    # --------------------------------------------------------
    # GAN-PPO
    # --------------------------------------------------------
    if "gan" in name:
        return "GAN_PPO"

    # --------------------------------------------------------
    # Kmeans+Decision -> KDT
    # Case-insensitive and exact combination
    # --------------------------------------------------------
    if "kmeans+decision" in name:
        return "KDT"

    # Also handle possible spacing variations
    if (
        "kmeans + decision" in name
        or "k-means+decision" in name
        or "k-means + decision" in name
    ):
        return "KDT"

    # --------------------------------------------------------
    # KG
    # --------------------------------------------------------
    if (
        re.search(r"\bkg\b", name)
        or "knowledge graph" in name
    ):
        return "KG"

    # --------------------------------------------------------
    # PPO
    # --------------------------------------------------------
    if re.search(r"\bppo\b", name):
        return "PPO"

    # --------------------------------------------------------
    # Fallback
    # --------------------------------------------------------
    return model_name.strip()


# ============================================================
# Read file
# ============================================================
with open(FILE_PATH, "r", encoding="utf-8") as f:
    text = f.read()


# ============================================================
# Extract model blocks
# ============================================================
pattern = re.compile(
    r"=+\s*\n"
    r"(.+?)\n"
    r"=+\s*\n"
    r"(.*?)(?=\n=+\s*\n|\Z)",
    re.DOTALL
)

matches = pattern.findall(text)

records = []

row_pattern = re.compile(
    r"Users\s*=\s*(\d+)"
    r"\s*\|\s*Time\s*=\s*([\d.]+)\s*ms"
    r"\s*\|\s*Scheduling\s*=\s*([\d.]+)%"
    r"\s*\|\s*QoS violation\s*=\s*([\d.]+)%"
    r"\s*\|\s*Resource efficiency\s*=\s*([\d.]+)%"
)


# ============================================================
# Parse data
# ============================================================
for model_name, block in matches:

    model_name = model_name.strip()

    # Assign short name for legend
    short_name = get_short_name(model_name)

    rows = row_pattern.findall(block)

    for users, time, scheduling, qos, efficiency in rows:

        users = int(users)

        if MIN_USERS <= users <= MAX_USERS:

            records.append({
                "Model": model_name,
                "Legend": short_name,
                "Users": users,
                "Time": float(time),
                "Scheduling": float(scheduling),
                "QoS Violation": float(qos),
                "Resource Efficiency": float(efficiency)
            })


# ============================================================
# Check extraction
# ============================================================
if not records:
    raise ValueError(
        "No data were extracted. Check the formatting of "
        "LSTM_Threat_Stats.txt."
    )

df = pd.DataFrame(records)


# ============================================================
# Print model-name mapping
# ============================================================
print("\n============================================================")
print("MODEL NAME MAPPING")
print("============================================================")

mapping = df[["Model", "Legend"]].drop_duplicates()

for _, row in mapping.iterrows():
    print(f"{row['Model']}  -->  {row['Legend']}")


# ============================================================
# Verify Kmeans+Decision mapping
# ============================================================
kmeans_models = df[
    df["Model"].str.lower().str.contains(
        "kmeans+decision",
        regex=False
    )
]

if len(kmeans_models) > 0:

    if not all(kmeans_models["Legend"] == "KDT"):
        raise ValueError(
            "ERROR: Kmeans+Decision was not mapped to KDT."
        )

    print("\nKmeans+Decision successfully mapped to KDT.")


