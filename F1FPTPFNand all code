class KnowledgeGraphModel:

    def __init__(self):

        self.feature_weights = None
        self.threshold = None

    def fit(self, X, y):

        # ----------------------------------------------------
        # Estimate feature relevance
        # ----------------------------------------------------

        correlations = []

        for j in range(X.shape[1]):

            feature = X[:, j]

            if np.std(feature) == 0:

                correlations.append(0.0)

            else:

                correlations.append(
                    abs(
                        np.corrcoef(
                            feature,
                            y
                        )[0, 1]
                    )
                )

        self.feature_weights = np.nan_to_num(
            correlations
        )

        weighted_score = np.sum(
            np.abs(X) *
            self.feature_weights,
            axis=1
        )

        self.threshold = np.percentile(
            weighted_score,
            70
        )

        return self

    def predict_action(self, x):

        score = np.sum(
            np.abs(x) *
            self.feature_weights
        )

        if score >= self.threshold:

            return 1

        return 0


