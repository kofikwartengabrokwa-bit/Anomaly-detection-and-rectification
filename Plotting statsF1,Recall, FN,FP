# ============================================================
# Interpolation function
# ============================================================

def interpolate_model_data(
    df,
    model,
    epoch_grid
):
    """
    Interpolate numerical metrics onto the common
    epoch grid.

    Interpolation is performed only within the
    observed epoch range.

    No extrapolation beyond observed data is performed.
    """

    model_df = (
        df[
            df["model"] == model
        ]
        .sort_values("epoch")
        .drop_duplicates(
            subset="epoch"
        )
    )

    result = pd.DataFrame(
        {
            "epoch": epoch_grid,
            "model": model
        }
    )

    if model_df.empty:

        for column in df.columns:

            if column not in [
                "model",
                "epoch"
            ]:

                result[column] = np.nan

        return result

    numerical_columns = [
        column
        for column in model_df.columns
        if column not in [
            "model",
            "epoch"
        ]
    ]

    for column in numerical_columns:

        valid = model_df[
            [
                "epoch",
                column
            ]
        ].dropna()

        if len(valid) == 0:

            result[column] = np.nan

        elif len(valid) == 1:

            result[column] = np.where(
                epoch_grid ==
                valid["epoch"].iloc[0],
                valid[column].iloc[0],
                np.nan
            )

        else:

            result[column] = np.interp(
                epoch_grid,
                valid["epoch"].values,
                valid[column].values
            )

            # Do not extrapolate outside observed range
            result.loc[
                epoch_grid <
                valid["epoch"].min(),
                column
            ] = np.nan

            result.loc[
                epoch_grid >
                valid["epoch"].max(),
                column
            ] = np.nan

    return result


