# ============================================================
# STORAGE
# ============================================================

data = {
    "SACFL": {
        "Round": [],
        "Q1": [],
        "Q2": [],
        "Actor": []
    },

    "SACDAFL": {
        "Round": [],
        "Q1": [],
        "Q2": [],
        "Actor": []
    }
}


# ============================================================
# REGULAR EXPRESSIONS
# ============================================================

model_pattern = re.compile(
    r"Running\s+with\s+(SACFL|SACDAFL)\s+Aggregator",
    re.IGNORECASE
)

round_pattern = re.compile(
    r"Round\s+(\d+)\s*/\s*(\d+)",
    re.IGNORECASE
)

q1_pattern = re.compile(
    r"Q1\s*=\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)",
    re.IGNORECASE
)

q2_pattern = re.compile(
    r"Q2\s*=\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)",
    re.IGNORECASE
)

actor_pattern = re.compile(
    r"Actor\s*=\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)",
    re.IGNORECASE
)


# ============================================================
# PARSE FILE
# ============================================================

current_model = None
current_round = None

for line in text.splitlines():

    stripped = line.strip()

    # --------------------------------------------------------
    # Detect model section
    # --------------------------------------------------------

    model_match = model_pattern.search(stripped)

    if model_match:

        current_model = model_match.group(1).upper()
        current_round = None

        print(
            f"\nDetected model: {current_model}"
        )

        continue

    # --------------------------------------------------------
    # Ignore text before a model section
    # --------------------------------------------------------

    if current_model not in MODELS:
        continue

    # --------------------------------------------------------
    # Detect round
    # --------------------------------------------------------

    round_match = round_pattern.search(stripped)

    if round_match:

        current_round = int(
            round_match.group(1)
        )

        continue

    # --------------------------------------------------------
    # Detect Q1, Q2 and Actor
    # --------------------------------------------------------

    q1_match = q1_pattern.search(stripped)
    q2_match = q2_pattern.search(stripped)
    actor_match = actor_pattern.search(stripped)

    if (
        current_round is not None
        and q1_match
        and q2_match
        and actor_match
    ):

        q1 = float(
            q1_match.group(1)
        )

        q2 = float(
            q2_match.group(1)
        )

        actor = float(
            actor_match.group(1)
        )

        data[current_model]["Round"].append(
            current_round
        )

        data[current_model]["Q1"].append(
            q1
        )

        data[current_model]["Q2"].append(
            q2
        )

        data[current_model]["Actor"].append(
            actor
        )

        current_round = None


