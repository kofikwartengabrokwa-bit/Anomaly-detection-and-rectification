        marker=style["marker"],
        markersize=markersize,
        markerfacecolor="white",
        markeredgecolor=style["color"],
        markeredgewidth=2.0,
        markevery=markevery,
        label=label,
        zorder=3
    )

    # --------------------------------------------------------
