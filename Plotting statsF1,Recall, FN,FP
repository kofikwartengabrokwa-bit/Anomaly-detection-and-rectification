# ============================================================
# Interpolation function
# ============================================================

def interpolate_model_data(
    df,
    model,
    epoch_grid
):
    """
    Interpolate numerical metrics for one model
    onto the common epoch grid.

    Extrapolation outside the observed epoch range
    is NOT performed. Values outside the available
    range remain NaN.
    """

    model_df = (
        df[
            df["model"] == model
        ]
        .sort_values("epoch")
        .drop_duplicates(
            subset="epoch"
        )
    )

    if model_df.empty:

        return pd.DataFrame(
            {
                "epoch": epoch_grid,
                "model": model
            }
        )

    result = pd.DataFrame(
        {
            "epoch": epoch_grid,
            "model": model
        }
    )

    numeric_columns = [
        column
        for column in model_df.columns
        if column not in [
            "model",
            "epoch"
        ]
    ]

    for column in numeric_columns:

        valid = model_df[
            [
                "epoch",
                column
            ]
        ].dropna()

        if len(valid) == 0:

            result[column] = np.nan

        elif len(valid) == 1:

            result[column] = np.where(
                epoch_grid == valid["epoch"].iloc[0],
                valid[column].iloc[0],
                np.nan
            )

        else:

            result[column] = np.interp(
                epoch_grid,
                valid["epoch"].values,
                valid[column].values,
                left=np.nan,
                right=np.nan
            )

    return result


# ============================================================
# Interpolate both datasets
