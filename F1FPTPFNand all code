import matplotlib.pyplot as plt

plt.rcParams["font.family"] = "Times New Roman"
plt.rcParams["font.size"] = 18

MODEL_ORDER = [
    "Ours (SLAM-LSTM-PPO)",
    "Kmeans+Decision",
    "Knowledge Graph",
    "GAN PPO",
    "PPO"
]


def plot_metric(
    dataframe,
    metric,
    ylabel,
    filename,
    ymin=None,
    ymax=None
):

    fig, ax = plt.subplots(
        figsize=(10, 6)
    )

    for model_name in MODEL_ORDER:

        subset = dataframe[
            dataframe["model"] ==
            model_name
        ].sort_values("users")

        ax.plot(
            subset["users"],
            subset[metric],
            marker="o",
            linewidth=2.2,
            markersize=7,
            label=model_name
        )

    ax.set_xlabel(
        "Number of users",
        fontsize=20
    )

    ax.set_ylabel(
        ylabel,
        fontsize=20
    )

    ax.set_xlim(
        100,
        1000
    )

    if ymin is not None:
        ax.set_ylim(
            bottom=ymin
        )

    if ymax is not None:
        ax.set_ylim(
            top=ymax
        )

    ax.grid(
        True,
        linestyle="--",
        alpha=0.5
    )

    ax.legend(
        loc="upper center",
        bbox_to_anchor=(0.5, 1.18),
        ncol=3,
        fontsize=13
    )

    plt.tight_layout()

    plt.savefig(
        os.path.join(
            RESULT_DIR,
            filename + ".png"
        ),
        dpi=600,
        bbox_inches="tight"
    )

    plt.savefig(
        os.path.join(
            RESULT_DIR,
            filename + ".eps"
        ),
        dpi=600,
        bbox_inches="tight"
    )

    plt.show()


