# ============================================================
# Desired legend order
# ============================================================
desired_order = [
    "Ours",
    "GAN_PPO",
    "KDT",
    "KG",
    "PPO"
]

present_models = df["Legend"].unique()

models = [
    model
    for model in desired_order
    if model in present_models
]

# Add unexpected models at the end, if any
for model in present_models:
    if model not in models:
        models.append(model)


# ============================================================
# Plot function
# ============================================================
def plot_metric(
        dataframe,
        metric,
        ylabel,
        filename,
        ylim=None
):

    users = sorted(
        dataframe["Users"].unique()
    )

    x = np.arange(len(users))

    width = 0.8 / len(models)

    fig, ax = plt.subplots(
        figsize=(12, 7)
    )

    for i, model in enumerate(models):

        model_data = dataframe[
            dataframe["Legend"] == model
        ]

        values = []

        for user in users:

            row = model_data[
                model_data["Users"] == user
            ]

            if len(row) > 0:
                values.append(
                    row.iloc[0][metric]
                )
            else:
                values.append(np.nan)

        offset = (
            i - (len(models) - 1) / 2
        ) * width

        ax.bar(
            x + offset,
            values,
            width=width,
            label=model
        )

    # ========================================================
    # Axes
    # ========================================================
    ax.set_xlabel(
        "Number of users"
    )

    ax.set_ylabel(
        ylabel
    )

    ax.set_xticks(x)

    ax.set_xticklabels(users)

    if ylim is not None:
        ax.set_ylim(ylim)

    # ========================================================
    # Grid
    # ========================================================
    ax.grid(
        axis="y",
        linestyle="--",
        linewidth=0.7,
        alpha=0.5
    )

    ax.set_axisbelow(True)

    # ========================================================
    # Legend
    # ========================================================
    ax.legend(
        loc="upper center",
        bbox_to_anchor=(0.5, 1.15),
        ncol=len(models),
        frameon=False
    )

    # ========================================================
    # Spines
    # ========================================================
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

    plt.tight_layout()

    # ========================================================
    # Save PNG
    # ========================================================
    png_path = os.path.join(
        OUTPUT_DIR,
        filename + ".png"
    )

    # ========================================================
    # Save EPS
    # ========================================================
    eps_path = os.path.join(
        OUTPUT_DIR,
        filename + ".eps"
    )

    plt.savefig(
        png_path,
        dpi=600,
        bbox_inches="tight"
    )

    plt.savefig(
        eps_path,
        dpi=600,
        bbox_inches="tight",
        format="eps"
    )

    plt.show()

    plt.close()

    print(f"Saved: {png_path}")
    print(f"Saved: {eps_path}")


