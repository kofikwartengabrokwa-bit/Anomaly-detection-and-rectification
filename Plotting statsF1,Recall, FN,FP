# ============================================================
# SINGLE-DATASET METRIC PLOTTING
# Plot order:
#   1. TP
#   2. FP
#   3. FN
#   4. Precision  = TP / (TP + FP)
#   5. Recall     = TP / (TP + FN)
# ============================================================

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# 1. PATH CONFIGURATION
# ============================================================

DATA_DIR = r"E:\Abrokwa\PycharmProjects\pythonProject1\pythonProject"

DATA_FILE = os.path.join(
    DATA_DIR,
    "model_training_metrics_with_TP_FP21ab1xa5 (1).xlsx"
)

OUTPUT_DIR = os.path.join(
    DATA_DIR,
    "plots_single_dataset"
)

os.makedirs(OUTPUT_DIR, exist_ok=True)


# ============================================================
# 2. MODEL CONFIGURATION
# ============================================================

MODELS = [
    "Pro_PPO",
    "GAN_PPO",
    "KG",
    "KMeans",
    "PPO"
]

DISPLAY_NAMES = {
    "Pro_PPO": "Ours",
    "GAN_PPO": "GAN_PPO",
    "KG": "KG",
    "KMeans": "KDT",
    "PPO": "PPO"
}


# ============================================================
# 3. MODEL STYLES
# ============================================================

MODEL_STYLE = {

    "Pro_PPO": {
        "color": "blue",
        "marker": "D",
        "linestyle": "-",
        "inner_color": "blue"
    },

    "GAN_PPO": {
        "color": "red",
        "marker": "s",
        "linestyle": "--",
        "inner_color": "red"
    },

    "KG": {
        "color": "green",
        "marker": "^",
        "linestyle": "-.",
        "inner_color": "green"
    },

    "KMeans": {
        "color": "purple",
        "marker": "p",
        "linestyle": ":",
        "inner_color": "purple"
    },

    "PPO": {
        "color": "orange",
        "marker": "o",
        "linestyle": (0, (5, 2, 1, 2)),
        "inner_color": "orange"
    }
}


# ============================================================
# 4. GLOBAL PLOT SETTINGS
# ============================================================

plt.rcParams["font.family"] = "Times New Roman"

plt.rcParams["font.size"] = 20
plt.rcParams["axes.labelsize"] = 21
plt.rcParams["xtick.labelsize"] = 19
plt.rcParams["ytick.labelsize"] = 19
plt.rcParams["legend.fontsize"] = 18


# ============================================================
# 5. LOAD DATASET
# ============================================================

if not os.path.exists(DATA_FILE):
    raise FileNotFoundError(
        f"\nDataset not found:\n{DATA_FILE}"
    )

print("=" * 100)
print("LOADING DATASET")
print("=" * 100)

df = pd.read_excel(DATA_FILE)

print(f"\nDataset: {os.path.basename(DATA_FILE)}")
print(f"Rows   : {len(df):,}")
print(f"Columns: {len(df.columns)}")

print("\nAvailable columns:")
print(list(df.columns))


# ============================================================
# 6. CHECK REQUIRED COLUMNS
# ============================================================

if "epoch" not in df.columns:
    raise ValueError(
        "The dataset must contain an 'epoch' column."
    )

if "model" not in df.columns:
    raise ValueError(
        "The dataset must contain a 'model' column."
    )


# ============================================================
# 7. CLEAN MODEL NAMES
# ============================================================

df["model"] = (
    df["model"]
    .astype(str)
    .str.strip()
)

df = df[
    df["model"].isin(MODELS)
].copy()

if df.empty:
    raise ValueError(
        "None of the expected models were found in the dataset."
    )


# ============================================================
# 8. CONVERT NUMERIC COLUMNS
# ============================================================

numeric_candidates = [
    "epoch",
    "TP",
    "FP",
    "FN",
    "Loss",
    "Accuracy",
    "F1"
]

for column in numeric_candidates:

    if column in df.columns:

        df[column] = pd.to_numeric(
            df[column],
            errors="coerce"
        )


# Remove rows without valid epoch
df = df.dropna(subset=["epoch"]).copy()

df["epoch"] = df["epoch"].astype(int)

df = df.sort_values(
    ["model", "epoch"]
).reset_index(drop=True)


# ============================================================
# 9. COMPUTE PRECISION
# ============================================================
#
# Precision = TP / (TP + FP)
#
# Precision is generated ONLY if both TP and FP
# are available in the same dataset.
# ============================================================

if "TP" in df.columns and "FP" in df.columns:

    denominator_precision = (
        df["TP"] + df["FP"]
    )

    df["Precision"] = np.where(
        denominator_precision > 0,
        df["TP"] / denominator_precision,
        np.nan
    )

    print("\nPrecision:")
    print("  TP and FP are available.")
    print("  Precision = TP / (TP + FP)")

else:

    print("\nPrecision:")
    print("  SKIPPED because TP and/or FP is unavailable.")


# ============================================================
# 10. COMPUTE RECALL
# ============================================================
#
# Recall = TP / (TP + FN)
#
# Recall is generated ONLY if both TP and FN
# are available in the same dataset.
# ============================================================

if "TP" in df.columns and "FN" in df.columns:

    denominator_recall = (
        df["TP"] + df["FN"]
    )

    df["Recall"] = np.where(
        denominator_recall > 0,
        df["TP"] / denominator_recall,
        np.nan
    )

    print("\nRecall:")
    print("  TP and FN are available.")
    print("  Recall = TP / (TP + FN)")

else:

    print("\nRecall:")
    print("  SKIPPED because TP and/or FN is unavailable.")


# ============================================================
# 11. DETERMINE WHICH METRICS ARE AVAILABLE
# ============================================================
#
# IMPORTANT:
# TP, FP, FN are plotted FIRST.
#
# Precision and Recall are plotted afterward.
# ============================================================

METRICS = []

# First: confusion-matrix count metrics
for metric in ["TP", "FP", "FN"]:

    if metric in df.columns:
        METRICS.append(metric)


# Second: derived identification metrics
if "Precision" in df.columns:
    METRICS.append("Precision")

if "Recall" in df.columns:
    METRICS.append("Recall")


print("\n" + "=" * 100)
print("PLOTTING ORDER")
print("=" * 100)

for i, metric in enumerate(METRICS, start=1):
    print(f"{i}. {metric}")


# ============================================================
# 12. PLOT FUNCTION
# ============================================================

def plot_model_with_marker(
    ax,
    x,
    y,
    model,
    linewidth=2.8,
    markersize=10,
    markevery=20,
    label=None
):

    style = MODEL_STYLE[model]

    # Main line and outer marker
    ax.plot(
        x,
        y,
        linewidth=linewidth,
        linestyle=style["linestyle"],
        color=style["color"],
        marker=style["marker"],
        markersize=markersize,
        markerfacecolor="white",
        markeredgecolor=style["color"],
        markeredgewidth=2.0,
        markevery=markevery,
        label=label,
        zorder=3
    )

    # Small inner circular marker
    ax.plot(
        x,
        y,
        linestyle="None",
        marker="o",
        markersize=markersize * 0.38,
        markerfacecolor=style["inner_color"],
        markeredgecolor="white",
        markeredgewidth=0.7,
        markevery=markevery,
        label="_nolegend_",
        zorder=4
    )


# ============================================================
# 13. PLOT EACH METRIC SEPARATELY
# ============================================================

for metric in METRICS:

    print("\n" + "=" * 100)
    print(f"PLOTTING: {metric}")
    print("=" * 100)

    fig, ax = plt.subplots(
        figsize=(11, 7)
    )

    plotted_any = False

    # --------------------------------------------------------
    # Plot each model
    # --------------------------------------------------------

    for model in MODELS:

        model_df = df[
            df["model"] == model
        ].copy()

        if model_df.empty:
            print(
                f"  {DISPLAY_NAMES[model]}: no data"
            )
            continue

        model_df = model_df.sort_values(
            "epoch"
        )

        x = model_df["epoch"].to_numpy()

        y = model_df[metric].to_numpy()

        valid = (
            np.isfinite(x)
            & np.isfinite(y)
        )

        x = x[valid]
        y = y[valid]

        if len(x) == 0:
            print(
                f"  {DISPLAY_NAMES[model]}: no valid {metric} values"
            )
            continue

        plot_model_with_marker(
            ax=ax,
            x=x,
            y=y,
            model=model,
            linewidth=2.8,
            markersize=10,
            markevery=max(1, len(x) // 20),
            label=DISPLAY_NAMES[model]
        )

        plotted_any = True

        print(
            f"  {DISPLAY_NAMES[model]}: "
            f"{len(x):,} points"
        )

    if not plotted_any:

        plt.close(fig)

        print(
            f"  No valid data available for {metric}."
        )

        continue


    # ========================================================
    # 14. AXIS LABELS
    # ========================================================

    ax.set_xlabel(
        "Epoch",
        fontsize=21,
        fontweight="bold"
    )

    ax.set_ylabel(
        metric,
        fontsize=21,
        fontweight="bold"
    )


    # ========================================================
    # 15. X-AXIS STARTS AT ZERO
    # ========================================================

    ax.set_xlim(
        left=0
    )


    # ========================================================
    # 16. Y-AXIS SETTINGS
    # ========================================================

    if metric in [
        "Accuracy",
        "F1",
        "Precision",
        "Recall"
    ]:

        ax.set_ylim(
            0,
            1.05
        )

    else:

        # TP, FP, FN should never be negative.
        ax.set_ylim(
            bottom=0
        )


    # ========================================================
    # 17. HANDLE VERY LARGE COUNT RANGES
    # ========================================================
    #
    # This changes only the visualization scale.
    # The original TP/FP/FN values are NOT modified.
    # ========================================================

    if metric in ["TP", "FP", "FN"]:

        valid_values = df[metric].dropna()

        if len(valid_values) > 0:

            positive_values = valid_values[
                valid_values > 0
            ]

            if len(positive_values) > 0:

                min_value = positive_values.min()
                max_value = positive_values.max()

                if (
                    min_value > 0
                    and max_value / min_value > 1000
                ):

                    ax.set_yscale("log")

                    print(
                        f"  Logarithmic y-axis enabled for {metric} "
                        f"because of the large dynamic range."
                    )


    # ========================================================
    # 18. GRID
    # ========================================================

    ax.grid(
        True,
        linestyle="--",
        linewidth=0.8,
        alpha=0.35
    )


    # ========================================================
    # 19. LEGEND
    # ========================================================

    ax.legend(
        loc="upper center",
        bbox_to_anchor=(0.5, 1.18),
        ncol=5,
        frameon=True,
        fontsize=18
    )


    # ========================================================
    # 20. TICKS
    # ========================================================

    ax.tick_params(
        axis="both",
        which="major",
        labelsize=19
    )


    # ========================================================
    # 21. TIGHT LAYOUT
    # ========================================================

    plt.tight_layout(
        rect=[0, 0, 1, 0.93]
    )


    # ========================================================
    # 22. SAVE FILES
    # ========================================================

    metric_filename = metric.lower()

    png_path = os.path.join(
        OUTPUT_DIR,
        f"{metric_filename}_comparison.png"
    )

    eps_path = os.path.join(
        OUTPUT_DIR,
        f"{metric_filename}_comparison.eps"
    )


    plt.savefig(
        png_path,
        dpi=600,
        bbox_inches="tight"
    )

    plt.savefig(
        eps_path,
        dpi=600,
        bbox_inches="tight",
        format="eps"
    )


    print(
        f"\nSaved PNG: {png_path}"
    )

    print(
        f"Saved EPS: {eps_path}"
    )


    plt.show()

    plt.close(fig)


# ============================================================
# 23. PRINT AVERAGE METRICS
# ============================================================

print("\n")
print("=" * 100)
print("AVERAGE METRICS")
print("=" * 100)

for metric in METRICS:

    print("\n" + "-" * 100)
    print(f"{metric}")
    print("-" * 100)

    for model in MODELS:

        model_df = df[
            df["model"] == model
        ]

        if model_df.empty:
            continue

        values = model_df[metric].dropna()

        if len(values) == 0:
            continue

        average = values.mean()

        print(
            f"{DISPLAY_NAMES[model]:<12}: "
            f"{average:.6f}"
        )


# ============================================================
# 24. FINAL SUMMARY
# ============================================================

print("\n")
print("=" * 100)
print("PLOTTING COMPLETED")
print("=" * 100)

print(
    f"\nDataset used:\n{DATA_FILE}"
)

print(
    f"\nOutput directory:\n{OUTPUT_DIR}"
)

print("\nMetrics plotted in order:")

for i, metric in enumerate(
    METRICS,
    start=1
):

    print(
        f"  {i}. {metric}"
    )

print("\nDone.")






import os

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# Configuration
# ============================================================

DATA_DIR = r"E:\Abrokwa\PycharmProjects\pythonProject1\pythonProject"


# ============================================================
# Input datasets
# ============================================================

# ------------------------------------------------------------
# Dataset containing TP and FN
# Used for Recall
# ------------------------------------------------------------

RECALL_FILE = os.path.join(
    DATA_DIR,
    "model_training_metrics_with_TP_FP21ab1xa64 (3).xlsx"
)


# ------------------------------------------------------------
# Dataset containing TP and FP
# Used for Precision and False Positives
# ------------------------------------------------------------

PRECISION_FILE = os.path.join(
    DATA_DIR,
    "model_training_metrics_with_TP_FP20.xlsx"
)


# ============================================================
# Models
# ============================================================

MODELS = [
    "Pro_PPO",
    "GAN_PPO",
    "KG",
    "KMeans",
    "PPO"
]


# ============================================================
# Display names
# ============================================================

LEGEND_NAMES = {
    "Pro_PPO": "Ours",
    "GAN_PPO": "GAN_PPO",
    "KG": "KG",
    "KMeans": "KDT",
    "PPO": "PPO"
}


# ============================================================
# Model visual styles
# ============================================================

MODEL_STYLE = {

    "Pro_PPO": {
        "color": "#1f77b4",
        "marker": "D",
        "inner_color": "#1f77b4",
        "linestyle": "-"
    },

    "GAN_PPO": {
        "color": "#d62728",
        "marker": "s",
        "inner_color": "#d62728",
        "linestyle": "--"
    },

    "KG": {
        "color": "#2ca02c",
        "marker": "^",
        "inner_color": "#2ca02c",
        "linestyle": "-."
    },

    "KMeans": {
        "color": "#9467bd",
        "marker": "p",
        "inner_color": "#9467bd",
        "linestyle": ":"
    },

    "PPO": {
        "color": "#ff7f0e",
        "marker": "o",
        "inner_color": "#ff7f0e",
        "linestyle": (0, (5, 2, 1, 2))
    }
}


# ============================================================
# Output directory
# ============================================================

OUTPUT_DIR = os.path.join(
    DATA_DIR,
    "plots"
)

os.makedirs(
    OUTPUT_DIR,
    exist_ok=True
)


# ============================================================
# Check input files
# ============================================================

if not os.path.exists(RECALL_FILE):

    raise FileNotFoundError(
        "\nRecall dataset was not found:\n"
        f"{RECALL_FILE}"
    )


if not os.path.exists(PRECISION_FILE):

    raise FileNotFoundError(
        "\nPrecision/FP dataset was not found:\n"
        f"{PRECISION_FILE}"
    )


# ============================================================
# Read Recall dataset
# ============================================================

print("=" * 90)
print("READING RECALL DATASET")
print("=" * 90)

recall_data = pd.read_excel(
    RECALL_FILE
)

print(
    f"File: {os.path.basename(RECALL_FILE)}"
)

print(
    f"Rows: {len(recall_data)}"
)

print(
    f"Columns: {recall_data.columns.tolist()}"
)


# ============================================================
# Verify Recall columns
# ============================================================

required_recall_columns = [
    "TP",
    "FN",
    "epoch",
    "model"
]

missing_recall = [
    column
    for column in required_recall_columns
    if column not in recall_data.columns
]

if missing_recall:

    raise ValueError(
        "The recall dataset is missing:\n"
        f"{missing_recall}"
    )


# ============================================================
# Read Precision / FP dataset
# ============================================================

print("\n" + "=" * 90)
print("READING PRECISION / FALSE POSITIVE DATASET")
print("=" * 90)

precision_data = pd.read_excel(
    PRECISION_FILE
)

print(
    f"File: {os.path.basename(PRECISION_FILE)}"
)

print(
    f"Rows: {len(precision_data)}"
)

print(
    f"Columns: {precision_data.columns.tolist()}"
)


# ============================================================
# Verify Precision / FP columns
# ============================================================

required_precision_columns = [
    "TP",
    "FP",
    "epoch",
    "model"
]

missing_precision = [
    column
    for column in required_precision_columns
    if column not in precision_data.columns
]

if missing_precision:

    raise ValueError(
        "The precision/FP dataset is missing:\n"
        f"{missing_precision}"
    )


# ============================================================
# Clean model names
# ============================================================

for df in [
    recall_data,
    precision_data
]:

    df["model"] = (
        df["model"]
        .astype(str)
        .str.strip()
        .str.replace(
            "\\",
            "",
            regex=False
        )
    )


# ============================================================
# Keep only requested models
# ============================================================

recall_data = recall_data[
    recall_data["model"].isin(MODELS)
].copy()


precision_data = precision_data[
    precision_data["model"].isin(MODELS)
].copy()


# ============================================================
# Convert numerical columns
# ============================================================

for column in [
    "TP",
    "FN",
    "epoch"
]:

    recall_data[column] = pd.to_numeric(
        recall_data[column],
        errors="coerce"
    )


for column in [
    "TP",
    "FP",
    "epoch"
]:

    precision_data[column] = pd.to_numeric(
        precision_data[column],
        errors="coerce"
    )


# ============================================================
# Remove invalid rows
# ============================================================

recall_data = recall_data.dropna(
    subset=[
        "TP",
        "FN",
        "epoch",
        "model"
    ]
)


precision_data = precision_data.dropna(
    subset=[
        "TP",
        "FP",
        "epoch",
        "model"
    ]
)


# ============================================================
# Prepare Recall data
# ============================================================

recall_data = recall_data[
    [
        "model",
        "epoch",
        "TP",
        "FN"
    ]
].copy()


# ============================================================
# Calculate Recall
# ============================================================

recall_denominator = (
    recall_data["TP"] +
    recall_data["FN"]
)

recall_data["Recall"] = np.where(
    recall_denominator > 0,
    recall_data["TP"] / recall_denominator,
    np.nan
)


# ============================================================
# Prepare Precision / FP data
# ============================================================

precision_data = precision_data[
    [
        "model",
        "epoch",
        "TP",
        "FP"
    ]
].copy()


# ============================================================
# Calculate Precision
# ============================================================

precision_denominator = (
    precision_data["TP"] +
    precision_data["FP"]
)

precision_data["Precision"] = np.where(
    precision_denominator > 0,
    precision_data["TP"] / precision_denominator,
    np.nan
)


# ============================================================
# Merge Recall, Precision and FP
# ============================================================

data = pd.merge(
    recall_data[
        [
            "model",
            "epoch",
            "Recall"
        ]
    ],

    precision_data[
        [
            "model",
            "epoch",
            "Precision",
            "FP"
        ]
    ],

    on=[
        "model",
        "epoch"
    ],

    how="inner"
)


# ============================================================
# Sort data
# ============================================================

data = data.sort_values(
    [
        "model",
        "epoch"
    ]
)


# ============================================================
# Remove invalid values
# ============================================================

data = data.replace(
    [
        np.inf,
        -np.inf
    ],
    np.nan
)


data = data.dropna(
    subset=[
        "Recall",
        "Precision",
        "FP"
    ]
)


# ============================================================
# Print overall data summary
# ============================================================

print("\n" + "=" * 90)
print("DATA SUMMARY")
print("=" * 90)

print(
    f"Matched model/epoch records: {len(data)}"
)

print(
    f"Models found: {data['model'].unique().tolist()}"
)


# ============================================================
# Print model statistics
# ============================================================

for model in MODELS:

    model_data = data[
        data["model"] == model
    ]

    print("\n" + "-" * 70)

    print(
        LEGEND_NAMES[model]
    )

    print("-" * 70)

    if model_data.empty:

        print(
            "No matched data."
        )

        continue


    print(
        f"Records         : {len(model_data)}"
    )

    print(
        f"Epoch range     : "
        f"{int(model_data['epoch'].min())}"
        f" - "
        f"{int(model_data['epoch'].max())}"
    )

    print(
        f"Average Recall  : "
        f"{model_data['Recall'].mean():.6f}"
    )

    print(
        f"Average Precision: "
        f"{model_data['Precision'].mean():.6f}"
    )

    print(
        f"Average FP      : "
        f"{model_data['FP'].mean():.2f}"
    )


# ============================================================
# Plotting function
# ============================================================

def plot_model_with_marker(
    ax,
    x,
    y,
    model,
    linewidth=2.5,
    markersize=9,
    markevery=20,
    label=None
):

    style = MODEL_STYLE[model]


    # --------------------------------------------------------
    # Main curve
    # --------------------------------------------------------

    ax.plot(
        x,
        y,

        linewidth=linewidth,

        linestyle=style["linestyle"],

        color=style["color"],

        marker=style["marker"],

        markersize=markersize,

        markerfacecolor="white",

        markeredgecolor=style["color"],

        markeredgewidth=2.0,

        markevery=markevery,

        label=label,

        zorder=3
    )


    # --------------------------------------------------------
    # Inner marker
    # --------------------------------------------------------

    ax.plot(
        x,
        y,

        linestyle="None",

        marker="o",

        markersize=markersize * 0.38,

        markerfacecolor=style["inner_color"],

        markeredgecolor="white",

        markeredgewidth=0.7,

        markevery=markevery,

        label="_nolegend_",

        zorder=4
    )


# ============================================================
# Function to plot one metric
# ============================================================

def plot_metric(
    metric,
    ylabel,
    filename,
    y_min=None,
    y_max=None
):

    print("\n" + "=" * 90)

    print(
        f"PLOTTING {ylabel.upper()}"
    )

    print("=" * 90)


    # --------------------------------------------------------
    # Create individual figure
    # --------------------------------------------------------

    fig, ax = plt.subplots(
        figsize=(11, 7)
    )


    # --------------------------------------------------------
    # Plot each model
    # --------------------------------------------------------

    for model in MODELS:

        model_data = data[
            data["model"] == model
        ].sort_values(
            "epoch"
        )


        if model_data.empty:

            print(
                f"Skipping {LEGEND_NAMES[model]} "
                f"(no data)"
            )

            continue


        markevery = max(
            1,
            len(model_data) // 20
        )


        plot_model_with_marker(
            ax=ax,

            x=model_data["epoch"],

            y=model_data[metric],

