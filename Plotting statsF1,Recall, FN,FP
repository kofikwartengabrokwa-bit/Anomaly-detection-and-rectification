    data["TP"] +
    data["FP"]
)

recall_denominator = (
    data["TP"] +
    data["FN"]
)


data["Precision"] = np.where(
    precision_denominator > 0,
    data["TP"] / precision_denominator,
    np.nan
)


data["Recall"] = np.where(
    recall_denominator > 0,
    data["TP"] / recall_denominator,
    np.nan
)


# ============================================================
# Combine Loss, Accuracy and F1
# ============================================================

for metric in TRAINING_METRICS:

    recall_column = (
        f"{metric}_recall"
    )

    precision_column = (
