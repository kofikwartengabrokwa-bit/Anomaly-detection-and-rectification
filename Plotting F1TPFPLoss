        left=0
    )

    plt.tight_layout()

    # ========================================================
    # OUTPUT FILENAMES
    # ========================================================

    # ========================================================
    # OUTPUT FILENAMES
    # ========================================================

    png_file = (
            OUTPUT_DIR /
            f"SACFL_vs_SACDAFL_{metric.lower()}.png"
    )

