class SLAMPPOAgent:

    def __init__(
        self,
        lstm_model
    ):

        self.lstm_model = lstm_model

        for parameter in self.lstm_model.parameters():
            parameter.requires_grad = False

        self.lstm_model.eval()

        self.context_dim = 128

        # 16 raw features
        # + 128 LSTM context
        # + BW
        # + RB
        # + anomaly probability
        state_dim = (
            16 +
            self.context_dim +
            2 +
            1
        )

        self.ppo = PPOAgent(
            state_dim=state_dim,
            action_dim=4
        )

    def construct_state(
        self,
        sequence,
        bw,
        rb
    ):

        tensor = torch.tensor(
            sequence,
            dtype=torch.float32,
            device=DEVICE
        ).unsqueeze(0)

        with torch.no_grad():

            logits, context = (
                self.lstm_model(tensor)
            )

            probabilities = torch.softmax(
                logits,
                dim=1
            )

            anomaly_probability = (
                1.0 -
                probabilities[:, 0:1]
            )

        latest_features = sequence[-1]

        state = torch.cat(
            [
                torch.tensor(
                    latest_features,
                    dtype=torch.float32,
                    device=DEVICE
                ).unsqueeze(0),

                context,

                torch.tensor(
                    [
                        bw / MAX_BW,
                        rb / MAX_RB
                    ],
                    dtype=torch.float32,
                    device=DEVICE
                ).unsqueeze(0),

                anomaly_probability
            ],
            dim=1
        )

        return state.cpu().numpy()[0]


def train_slam_ppo(
