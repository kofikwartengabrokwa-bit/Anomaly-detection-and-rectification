    fig, ax = plt.subplots(
        figsize=(10, 7)
    )

    # --------------------------------------------------------
    # Plot all models
    # --------------------------------------------------------

    for model in MODELS:

        model_data = data[
            data["model"] == model
        ].sort_values("epoch")

        if model_data.empty:
            continue

        plot_model_with_marker(
