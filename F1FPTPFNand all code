class SLAMLSTM(nn.Module):

    def __init__(
        self,
        input_dim=16,
        hidden_dim=128,
        layers=10,
        num_classes=6
    ):

        super().__init__()

        self.lstm = nn.LSTM(
            input_dim,
            hidden_dim,
            num_layers=layers,
            batch_first=True
        )

        self.attention = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim),
            nn.Tanh(),
            nn.Linear(hidden_dim, 1)
        )

        self.classifier = nn.Linear(
            hidden_dim,
            num_classes
        )

    def forward(self, x):

        lstm_output, _ = self.lstm(x)

        attention_scores = self.attention(
            lstm_output
        )

        attention_weights = torch.softmax(
            attention_scores,
            dim=1
        )

        context = torch.sum(
            attention_weights *
            lstm_output,
            dim=1
        )

        logits = self.classifier(
            context
        )

        return logits, context

