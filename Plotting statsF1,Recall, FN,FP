        .str.strip()
        .str.replace("\\", "", regex=False)
    )

    return df


# ============================================================
# Utility: convert numerical columns
# ============================================================

def convert_numeric(df, columns):

    df = df.copy()

    for column in columns:

        if column in df.columns:

            df[column] = pd.to_numeric(
                df[column],
                errors="coerce"
            )

    return df


# ============================================================
