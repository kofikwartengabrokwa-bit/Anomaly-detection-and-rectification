        ]
    )

    actor_loss = np.asarray(
        history[
            "actor_loss"
        ]
    )

    critic_loss = np.asarray(
        history[
            "critic_loss"
        ]
    )

    total_loss = np.asarray(
        history[
            "total_loss"
        ]
    )

    entropy = np.asarray(
        history[
            "entropy"
        ]
    )


    # ------------------------------------------------------------
    # CONVERGENCE
    # ------------------------------------------------------------

    moving_reward = smooth(
        rewards,
        SMOOTH_WINDOW
    )


    if len(moving_reward) > 0:

        final_moving_reward = (
            moving_reward[-1]
        )

        convergence_threshold = (
            0.95
            *
            final_moving_reward
        )


        convergence_indices = np.where(
            moving_reward
            >=
            convergence_threshold
        )[0]


        if len(convergence_indices) > 0:

            convergence_episode = (
                convergence_indices[0]
                +
                SMOOTH_WINDOW
            )

        else:

            convergence_episode = np.nan

    else:

        final_moving_reward = np.nan

        convergence_episode = np.nan


    # ------------------------------------------------------------
    # FINAL WINDOW
    # ------------------------------------------------------------

    final_window = min(
        SMOOTH_WINDOW,
        len(rewards)
    )


    final_rewards = (
        rewards[-final_window:]
    )

    final_scheduling = (
        scheduling[-final_window:]
    )

    final_resource = (
        resource[-final_window:]
    )


    # ------------------------------------------------------------
    # SUMMARY
    # ------------------------------------------------------------

    row = {

        "learning_rate":
            float(lr),

        "average_reward":
            np.mean(rewards),

        "final_reward":
            rewards[-1],

        "best_reward":
            np.max(rewards),

        "reward_std":
            np.std(rewards),

        "final_avg_reward":
            np.mean(final_rewards),

        "final_reward_std":
