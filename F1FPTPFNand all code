# ============================================================
# SMOOTHING FUNCTION
# ============================================================

def smooth(values, window=SMOOTH_WINDOW):
    """
    Smooth a sequence using a centered moving average.

    Parameters
    ----------
    values : array-like
        Reward values.
    window : int
        Moving-average window size.

    Returns
    -------
    numpy.ndarray
        Smoothed reward values.
    """

    values = np.asarray(values, dtype=float)

    if len(values) < 3:
        return values.copy()

    # Ensure an odd window for centered smoothing
    window = int(window)

    if window < 3:
        return values.copy()

    if window % 2 == 0:
        window += 1

    # Prevent the window from exceeding the data length
    if window > len(values):
        window = len(values)

        if window % 2 == 0:
            window -= 1

    if window < 3:
        return values.copy()

    kernel = np.ones(window) / window

    # Edge padding prevents the curve from shrinking at the boundaries
    pad = window // 2

    padded = np.pad(
        values,
        (pad, pad),
        mode="edge"
    )

    smoothed = np.convolve(
        padded,
        kernel,
        mode="valid"
    )

    return smoothed


