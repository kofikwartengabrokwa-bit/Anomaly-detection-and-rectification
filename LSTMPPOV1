        "final_entropy":
            entropy[-1],

        "average_scheduling_efficiency":
            100.0 * np.mean(scheduling),

        "final_scheduling_efficiency":
            100.0 * np.mean(final_scheduling),

        "average_resource_efficiency":
            100.0 * np.mean(resource),

        "final_resource_efficiency":
            100.0 * np.mean(final_resource),

        "convergence_episode":
            convergence_episode
    }


    summary_rows.append(
        row
    )


