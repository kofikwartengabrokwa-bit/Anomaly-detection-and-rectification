sample_counts = []

for class_id in range(num_classes):

    # Select predictions belonging to this class
    class_mask = (
        all_predictions == class_id
    )

    class_confidences = (
        all_confidences[class_mask]
    )

    sample_count = len(
        class_confidences
    )

    sample_counts.append(
        sample_count
    )

    if sample_count == 0:

        mean_confidence.append(
            np.nan
        )

        high_confidence_rate.append(
            np.nan
        )

        low_confidence_rate.append(
            np.nan
        )

        continue

    # Mean confidence
    mean_value = (
        np.mean(class_confidences)
    )

    # High-confidence percentage
    high_value = (
        np.mean(
            class_confidences
            >= HIGH_CONFIDENCE_THRESHOLD
        )
        * 100
    )

    # Low-confidence percentage
    low_value = (
        np.mean(
            class_confidences
            < LOW_CONFIDENCE_THRESHOLD
        )
        * 100
    )

    mean_confidence.append(
        mean_value * 100
    )

    high_confidence_rate.append(
        high_value
    )

    low_confidence_rate.append(
        low_value
    )


