# ================================================================
# BLOCK 6: O-RAN RESOURCE-SCHEDULING ENVIRONMENT
# ================================================================

class ORANEnvironment:

    def __init__(
        self,
        sequences,
        random_seed=420
    ):

        self.sequences = sequences

        self.rng = np.random.default_rng(
            random_seed
        )

        self.seq_len = sequences.shape[1]

        self.feature_dim = sequences.shape[2]

        self.state_dim = (
            self.feature_dim + 2
        )

        self.current_sequence = None

        self.current_step = 0

        self.bandwidth = 60.0

        self.resource_blocks = 164.0


    # ------------------------------------------------------------
    # RESET
    # ------------------------------------------------------------

    def reset(self):

        index = self.rng.integers(
            0,
            len(self.sequences)
        )

        self.current_sequence = (
            self.sequences[index].copy()
        )

        self.current_step = 0

        self.bandwidth = 60.0

        self.resource_blocks = 164.0

        return self._get_state()


    # ------------------------------------------------------------
    # CURRENT STATE
    # ------------------------------------------------------------

    def _get_state(self):

        sequence = self.current_sequence.copy()

        bw_normalized = (
            self.bandwidth / MAX_BW
        )

        rb_normalized = (
            self.resource_blocks / MAX_RB
        )

        resources = np.column_stack(
            [
                np.full(
                    self.seq_len,
                    bw_normalized,
                    dtype=np.float32
                ),
                np.full(
                    self.seq_len,
                    rb_normalized,
                    dtype=np.float32
                )
            ]
        )

        state_sequence = np.concatenate(
            [
                sequence,
                resources
            ],
            axis=1
        )

        return state_sequence.astype(
            np.float32
        )


    # ------------------------------------------------------------
    # RESOURCE ACTION
    # ------------------------------------------------------------

    def _apply_action(self, action):

        if action == 0:

            # Maintain
            bw_factor = 1.00

        elif action == 1:

            # Increase by 10%
            bw_factor = 1.10

        elif action == 2:

            # Increase by 25%
            bw_factor = 1.25

        elif action == 3:

            # Decrease by 10%
            bw_factor = 0.90

        else:

            raise ValueError(
                f"Invalid action: {action}"
            )


        self.bandwidth *= bw_factor

        self.resource_blocks *= bw_factor


        # --------------------------------------------------------
        # RESOURCE LIMITS
        # --------------------------------------------------------

        self.bandwidth = np.clip(
            self.bandwidth,
            MIN_BW,
            MAX_BW
        )

        self.resource_blocks = np.clip(
            self.resource_blocks,
            MIN_RB,
            MAX_RB
        )


    # ------------------------------------------------------------
    # QOS EVALUATION
    # ------------------------------------------------------------

    def _qos_score(self):

        current_features = (
            self.current_sequence[-1]
        )

        # Scaled features are used here only to provide
        # relative QoS indicators for the learning environment.

        bler = current_features[2]

        sinr = current_features[10]

        cqi = current_features[13]


        bler_ok = (
            bler <= BLER_THRESHOLD
        )

        sinr_ok = (
            sinr >= SINR_THRESHOLD
        )

        cqi_ok = (
            cqi >= CQI_THRESHOLD
        )


        qos_score = (
            float(bler_ok)
            +
            float(sinr_ok)
            +
            float(cqi_ok)
        ) / 3.0


        return qos_score


    # ------------------------------------------------------------
    # RESOURCE EFFICIENCY
    # ------------------------------------------------------------

    def _resource_efficiency(self):

        bw_efficiency = (
            self.bandwidth / MAX_BW
        )

        rb_efficiency = (
            self.resource_blocks / MAX_RB
        )

        # Lower resource usage while maintaining QoS
        # corresponds to higher efficiency.

        efficiency = (
            1.0
            -
            0.2 * (
                bw_efficiency
                +
                rb_efficiency
            )
        )

        return float(
            np.clip(
                efficiency,
                0.20,
                1.0
            )
        )


    # ------------------------------------------------------------
    # SCHEDULING EFFICIENCY
    # ------------------------------------------------------------

    def _scheduling_efficiency(
        self,
        qos_score
    ):

        resource_usage = (
            0.5 * (
                self.bandwidth / MAX_BW
                +
                self.resource_blocks / MAX_RB
            )
        )

        efficiency = (
            qos_score
            *
            (1.0 - 0.2 * resource_usage)
        )

        return float(
            np.clip(
                efficiency,
                0.14,
                1.0
            )
        )


    # ------------------------------------------------------------
    # STEP
    # ------------------------------------------------------------

    def step(self, action):

        self._apply_action(action)

        qos_score = self._qos_score()

        resource_efficiency = (
            self._resource_efficiency()
        )

        scheduling_efficiency = (
            self._scheduling_efficiency(
                qos_score
            )
        )


        # --------------------------------------------------------
        # REWARD
        # --------------------------------------------------------

        reward = (
            2.0 * scheduling_efficiency
            +
            resource_efficiency
            -
            0.13 * (1.0 - qos_score)
        )


        self.current_step += 1

        done = (
            self.current_step
            >= STEPS_PER_EPISODE
        )


        info = {

            "qos_score":
                qos_score,

            "resource_efficiency":
                resource_efficiency,

            "scheduling_efficiency":
                scheduling_efficiency,

            "bandwidth":
                self.bandwidth,

            "resource_blocks":
                self.resource_blocks,

            "action":
                action
        }


        return (
            self._get_state(),
            float(reward),
            done,
            info
        )


# ================================================================
# BLOCK 7: SLAM-LSTM-PPO NETWORK
# ================================================================

class SLAMLSTMPPO(nn.Module):

    def __init__(
        self,
        input_dim,
        hidden_size,
        lstm_layers,
        action_dim
    ):

        super().__init__()


        # --------------------------------------------------------
        # LSTM
        # --------------------------------------------------------

        self.lstm = nn.LSTM(
            input_size=input_dim,
            hidden_size=hidden_size,
            num_layers=lstm_layers,
            batch_first=True
        )


        # --------------------------------------------------------
        # FEATURE REPRESENTATION
        # --------------------------------------------------------

        self.feature_layer = nn.Sequential(

            nn.Linear(
                hidden_size,
                hidden_size
            ),

            nn.Tanh()
        )


        # --------------------------------------------------------
        # ACTOR
        # --------------------------------------------------------

        self.actor = nn.Sequential(

            nn.Linear(
                hidden_size,
                hidden_size
            ),

            nn.Tanh(),

            nn.Linear(
                hidden_size,
                action_dim
            )
        )


        # --------------------------------------------------------
        # CRITIC
        # --------------------------------------------------------

        self.critic = nn.Sequential(

            nn.Linear(
                hidden_size,
                hidden_size
            ),

            nn.Tanh(),

            nn.Linear(
                hidden_size,
                1
            )
        )


    def forward(self, x):

        lstm_output, _ = self.lstm(x)

        # Last temporal representation
        last_output = lstm_output[:, -1, :]

        features = self.feature_layer(
            last_output
        )

        logits = self.actor(
            features
        )

        value = self.critic(
            features
        ).squeeze(-1)

        return logits, value


    def get_action(
        self,
        state,
        deterministic=False
    ):

        state_tensor = torch.tensor(
            state,
            dtype=torch.float32,
            device=DEVICE
        ).unsqueeze(0)

        logits, value = self.forward(
            state_tensor
        )

        distribution = Categorical(
            logits=logits
        )

        if deterministic:

            action = torch.argmax(
                logits,
                dim=-1
            )

        else:

            action = distribution.sample()


        log_probability = (
            distribution.log_prob(action)
        )

        entropy = (
            distribution.entropy()
        )


        return (
            action.item(),
            log_probability.item(),
            value.item(),
            entropy.item()
        )


# ================================================================
# BLOCK 8: GENERALIZED ADVANTAGE ESTIMATION
# ================================================================

def calculate_gae(
    rewards,
    values,
    dones,
    gamma=GAMMA,
    gae_lambda=GAE_LAMBDA
):

    advantages = np.zeros_like(
        rewards,
        dtype=np.float32
    )

    gae = 0.0

    for t in reversed(
        range(len(rewards))
    ):

        if t == len(rewards) - 1:

            next_value = 0.0

        else:

            next_value = values[t + 1]


        next_non_terminal = (
            1.0 - dones[t]
        )


        delta = (
            rewards[t]
            +
            gamma
            *
            next_value
            *
            next_non_terminal
            -
            values[t]
        )


        gae = (
            delta
            +
            gamma
            *
            gae_lambda
            *
            next_non_terminal
            *
            gae
        )


        advantages[t] = gae


    returns = (
        advantages
        +
        np.asarray(
            values,
            dtype=np.float32
        )
    )


    return (
        advantages,
        returns
    )



# ================================================================
# BLOCK 9: PPO UPDATE
# ================================================================

def ppo_update(
    model,
    optimizer,
    states,
    actions,
    old_log_probs,
    returns,
    advantages
):

    states = torch.tensor(
        np.asarray(states),
        dtype=torch.float32,
        device=DEVICE
    )

    actions = torch.tensor(
        actions,
        dtype=torch.long,
        device=DEVICE
    )

    old_log_probs = torch.tensor(
        old_log_probs,
        dtype=torch.float32,
        device=DEVICE
    )

    returns = torch.tensor(
        returns,
        dtype=torch.float32,
        device=DEVICE
    )

    advantages = torch.tensor(
        advantages,
        dtype=torch.float32,
        device=DEVICE
    )


    # ------------------------------------------------------------
    # ADVANTAGE NORMALIZATION
    # ------------------------------------------------------------

    advantages = (
        advantages
        -
        advantages.mean()
    ) / (
        advantages.std()
        + 1e-8
    )


    actor_losses = []
    critic_losses = []
    entropy_values = []
    total_losses = []


    for _ in range(PPO_EPOCHS):

        logits, values = model(
            states
        )


        distribution = Categorical(
            logits=logits
        )


        new_log_probs = (
            distribution.log_prob(
                actions
            )
        )


        entropy = (
            distribution.entropy().mean()
        )


        # --------------------------------------------------------
        # PPO RATIO
        # --------------------------------------------------------

        ratio = torch.exp(
            new_log_probs
            -
            old_log_probs
        )


        # --------------------------------------------------------
        # CLIPPED SURROGATE
        # --------------------------------------------------------

        surrogate_1 = (
            ratio
            *
            advantages
        )


        surrogate_2 = (
            torch.clamp(
                ratio,
                1.0 - CLIP_EPSILON,
                1.0 + CLIP_EPSILON
            )
            *
            advantages
        )


        actor_loss = -torch.min(
            surrogate_1,
            surrogate_2
        ).mean()


        # --------------------------------------------------------
        # CRITIC LOSS
        # --------------------------------------------------------

        critic_loss = nn.functional.mse_loss(
            values,
            returns
        )


        # --------------------------------------------------------
        # TOTAL PPO LOSS
        # --------------------------------------------------------

        total_loss = (
            actor_loss
            +
            VALUE_COEF * critic_loss
            -
            ENTROPY_COEF * entropy
        )


        optimizer.zero_grad()

        total_loss.backward()

        nn.utils.clip_grad_norm_(
            model.parameters(),
            MAX_GRAD_NORM
        )

        optimizer.step()


        actor_losses.append(
            actor_loss.item()
        )

        critic_losses.append(
            critic_loss.item()
        )

        entropy_values.append(
            entropy.item()
        )

        total_losses.append(
            total_loss.item()
        )


    return {

        "actor_loss":
            float(np.mean(actor_losses)),

        "critic_loss":
            float(np.mean(critic_losses)),

        "entropy":
            float(np.mean(entropy_values)),

        "total_loss":
            float(np.mean(total_losses))
    }


# ================================================================
# BLOCK 10: SMOOTHING FUNCTION
# ================================================================

def smooth(
    values,
    window=100
):

    values = np.asarray(
        values,
        dtype=np.float64
    )

    if len(values) < window:

        return values


    kernel = np.ones(
        window
    ) / window


    return np.convolve(
        values,
        kernel,
        mode="valid"
    )


# ================================================================
# BLOCK 11: TRAIN ONE SLAM-LSTM-PPO MODEL
# ================================================================

def train_slam_lstm_ppo(
    learning_rate,
    train_sequences,
    run_seed=420
):

    print("\n")
    print("=" * 80)
    print(
        f"STARTING TRAINING | LEARNING RATE = {learning_rate:.0e}"
    )
    print("=" * 80)


    # ------------------------------------------------------------
    # RESET RANDOM SEEDS
    # ------------------------------------------------------------

    random.seed(run_seed)

    np.random.seed(run_seed)

    torch.manual_seed(run_seed)

    if torch.cuda.is_available():

        torch.cuda.manual_seed_all(
            run_seed
        )


    # ------------------------------------------------------------
    # ENVIRONMENT
    # ------------------------------------------------------------

    env = ORANEnvironment(
        train_sequences,
        random_seed=run_seed
    )


    # ------------------------------------------------------------
    # MODEL
    # ------------------------------------------------------------

    input_dim = (
        train_sequences.shape[-1]
        +
        2
    )


    model = SLAMLSTMPPO(
        input_dim=input_dim,
        hidden_size=HIDDEN_SIZE,
        lstm_layers=LSTM_LAYERS,
        action_dim=ACTION_DIM
    ).to(DEVICE)


    # ------------------------------------------------------------
    # EXPLICIT LEARNING RATE
    # ------------------------------------------------------------

    optimizer = optim.Adam(
        model.parameters(),
        lr=learning_rate
    )


    # ------------------------------------------------------------
    # METRIC STORAGE
    # ------------------------------------------------------------

    history = {

        "episode": [],

        "reward": [],

        "actor_loss": [],

        "critic_loss": [],

        "total_loss": [],

        "entropy": [],

        "scheduling_efficiency": [],

        "resource_efficiency": [],

        "qos_score": [],

        "bandwidth": [],

        "resource_blocks": []
    }


    recent_rewards = deque(
        maxlen=SMOOTH_WINDOW
    )


    # ------------------------------------------------------------
    # TRAINING
    # ------------------------------------------------------------

    for episode in range(
        1,
        NUM_EPISODES + 1
    ):

        state = env.reset()


        states = []
        actions = []
        rewards = []
        values = []
        log_probs = []
        dones = []


        episode_scheduling = []
        episode_resource = []
        episode_qos = []


        # --------------------------------------------------------
        # EPISODE
        # --------------------------------------------------------

        for step in range(
            STEPS_PER_EPISODE
        ):

            (
                action,
                log_prob,
                value,
                entropy
            ) = model.get_action(
                state
            )


            next_state, reward, done, info = (
                env.step(action)
            )


            states.append(
                state
            )

            actions.append(
                action
            )

            rewards.append(
                reward
            )

            values.append(
                value
            )

            log_probs.append(
                log_prob
            )

            dones.append(
                float(done)
            )


            episode_scheduling.append(
                info[
                    "scheduling_efficiency"
                ]
            )

            episode_resource.append(
                info[
                    "resource_efficiency"
                ]
            )

            episode_qos.append(
                info[
                    "qos_score"
                ]
            )


            state = next_state


            if done:

                break


        # --------------------------------------------------------
        # GAE
        # --------------------------------------------------------

        advantages, returns = calculate_gae(
            rewards,
            values,
            dones
        )


        # --------------------------------------------------------
        # PPO UPDATE
        # --------------------------------------------------------

        loss_stats = ppo_update(

            model=model,

            optimizer=optimizer,

            states=states,

            actions=actions,

            old_log_probs=log_probs,

            returns=returns,

            advantages=advantages
        )


        # --------------------------------------------------------
        # EPISODE METRICS
        # --------------------------------------------------------

        episode_reward = float(
            np.sum(rewards)
        )


        scheduling_efficiency = float(
            np.mean(
                episode_scheduling
            )
        )


        resource_efficiency = float(
            np.mean(
                episode_resource
            )
        )


        qos_score = float(
            np.mean(
                episode_qos
            )
        )


        recent_rewards.append(
            episode_reward
        )


        moving_reward = float(
            np.mean(
                recent_rewards
            )
        )


        history["episode"].append(
            episode
        )

        history["reward"].append(
            episode_reward
        )

        history["actor_loss"].append(
            loss_stats["actor_loss"]
        )

        history["critic_loss"].append(
            loss_stats["critic_loss"]
        )

        history["total_loss"].append(
            loss_stats["total_loss"]
        )

        history["entropy"].append(
            loss_stats["entropy"]
        )

        history[
            "scheduling_efficiency"
        ].append(
            scheduling_efficiency
        )

        history[
            "resource_efficiency"
        ].append(
            resource_efficiency
        )

        history["qos_score"].append(
            qos_score
        )

        history["bandwidth"].append(
            env.bandwidth
        )

        history["resource_blocks"].append(
            env.resource_blocks
        )


        # --------------------------------------------------------
        # PRINT TRAINING STATISTICS
        # --------------------------------------------------------

        if (
            episode == 1
            or
            episode % PRINT_INTERVAL == 0
        ):

            print(
                f"LR={learning_rate:.0e} | "
                f"Episode={episode:5d}/{NUM_EPISODES} | "
                f"Reward={episode_reward:9.4f} | "
                f"AvgReward={moving_reward:9.4f} | "
                f"Actor={loss_stats['actor_loss']:9.5f} | "
                f"Critic={loss_stats['critic_loss']:9.5f} | "
                f"PPO={loss_stats['total_loss']:9.5f} | "
                f"Entropy={loss_stats['entropy']:8.5f} | "
                f"Sched={100*scheduling_efficiency:7.3f}% | "
                f"ResEff={100*resource_efficiency:7.3f}%"
            )


    print("\n")
    print(
        f"COMPLETED LEARNING RATE = {learning_rate:.0e}"
    )

    return model, history



