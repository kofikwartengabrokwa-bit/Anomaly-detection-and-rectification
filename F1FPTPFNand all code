            seed=SEED + users
        )

        result["model"] = model_name

        all_results.append(
            result
        )

        print(
            f"Users={users:4d} | "
            f"Time={result['execution_time_ms']:.3f} ms | "
            f"Scheduling={result['scheduling_efficiency']:.2f}% | "
            f"QoS violation={result['qos_violation_rate']:.2f}% | "
            f"Resource efficiency={result['resource_allocation_efficiency']:.2f}%"
        )

results_df = pd.DataFrame(
    all_results
)

