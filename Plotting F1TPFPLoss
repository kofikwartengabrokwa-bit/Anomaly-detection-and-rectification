def plot_metric(metric):

    rounds = np.array(
        common_rounds
    )

    sacfl_values = (
        sacfl_common[metric]
        .to_numpy(dtype=float)
    )

    sacdafl_values = (
        sacdafl_common[metric]
        .to_numpy(dtype=float)
    )

    # ========================================================
    # MEAN AND STANDARD DEVIATION
    # ========================================================

    model_values = np.vstack(
        (
            sacfl_values,
            sacdafl_values
        )
    )

    mean_values = np.mean(
        model_values,
        axis=0
    )

    std_values = np.std(
        model_values,
        axis=0,
        ddof=1
    )

    mean_sd = np.mean(
        std_values
    )

    # ========================================================
    # CREATE FIGURE
    # ========================================================

    fig, ax = plt.subplots(
        figsize=(11, 7)
    )

    # ========================================================
    # SACFL
    # ========================================================

    ax.plot(
        rounds,
        sacfl_values,
        marker="o",
        markersize=6,
        linewidth=2.5,
        label="Vanilla"
    )

    # ========================================================
    # SACDAFL
    # ========================================================

    ax.plot(
        rounds,
        sacdafl_values,
        marker="s",
        markersize=6,
        linewidth=2.5,
        label="SAC-Fedprox"
    )

    # ========================================================
    # PINK STANDARD-DEVIATION REGION
    # ========================================================

    ax.fill_between(
        rounds,
        mean_values - std_values,
        mean_values + std_values,
        color="pink",
        alpha=0.35,
        label=r"Mean $\pm$ SD"
    )

    # ========================================================
    # MEAN SD ANNOTATION
    # ========================================================

    ax.text(
        0.03,
        0.95,
        f"Mean SD = {mean_sd:.4f}",
        transform=ax.transAxes,
        fontsize=17,
        fontname="Times New Roman",
        verticalalignment="top",
        horizontalalignment="left",
        bbox=dict(
            boxstyle="round,pad=0.25",
            facecolor="white",
            edgecolor="black",
            linewidth=0.8
        )
    )

    # ========================================================
    # AXIS LABELS
    # ========================================================

    ax.set_xlabel(
        "Round",
        fontsize=20,
        fontname="Times New Roman"
    )

    ax.set_ylabel(
        "Loss",
        fontsize=20,
        fontname="Times New Roman"
    )

    # ========================================================
    # TICKS
    # ========================================================

    ax.tick_params(
        axis="both",
        labelsize=17,
        width=1.5
    )

    for label in ax.get_xticklabels():
